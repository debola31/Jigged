# Supabase Configuration
# Get these values from your Supabase project settings:
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SECRET_KEY=your-secret-key-here

# Supabase Storage Bucket Name
# This is the name of the S3 bucket for file attachments (quotes, jobs)
NEXT_PUBLIC_SUPABASE_S3_BUCKET=your-bucket-name

# API URL - only needed for local development
# Leave unset in production (Vercel uses relative URLs since FastAPI runs on same domain)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Origin baked into printed QR codes (job travelers, location labels).
# LEAVE THIS UNSET locally and on preview branches: it falls back to window.location.origin, so a
# label printed from a dev server scans back to that dev server. It is set ONLY in Vercel's
# Production environment, because a sticker printed from a preview deployment would otherwise carry
# that deployment's hostname for the life of the label. Inlined at build time — a redeploy is what
# makes a change take.
# NEXT_PUBLIC_SCAN_ORIGIN=https://www.jigged.app

# ── QuickBooks Online integration (backend-only; push quotes -> invoices) ──
# App keys from https://developer.intuit.com -> your app -> Keys & OAuth. ONE name
# per credential, whose VALUE differs per deployment environment: sandbox keys
# locally and in preview, production keys in production, via Vercel's
# per-environment scoping. (Until 2026-08-15 production read a QUICKBOOKS_PROD_*
# pair and fell back to these names when it was unset. The pair was never set, so
# the fallback was the live path -- four names for two values, and a way to be
# silently wrong. An unset credential now raises instead.)
QUICK_BOOKS_CLIENT_ID=your-quickbooks-client-id
QUICK_BOOKS_CLIENT_SECRET=your-quickbooks-client-secret
# 'sandbox' while testing with dev keys; 'production' once Intuit issues prod keys.
QUICKBOOKS_ENVIRONMENT=sandbox
# Must EXACTLY match a Redirect URI registered on the Intuit app (Keys & OAuth).
QUICKBOOKS_REDIRECT_URI=http://localhost:8000/api/quickbooks/callback
# Frontend origin the post-OAuth callback redirects back to. Set per environment
# to the STABLE domain (same host as QUICKBOOKS_REDIRECT_URI). Locally the frontend
# is :3000 while the backend callback is :8000, so they differ. Do NOT use Vercel's
# dynamic VERCEL_URL here — it's the deployment host, not the user's domain.
APP_BASE_URL=http://localhost:3000
# HMAC secret for the OAuth state token (falls back to SUPABASE_JWT_SECRET if unset).
QUICKBOOKS_STATE_SECRET=generate-a-random-string
# Pin a QBO API minor version (test bumps in sandbox before production).
QUICKBOOKS_MINOR_VERSION=75
# Once Intuit approves the app for production, put the production keys in the
# SAME two variables above, scoped to the production environment -- there is no
# separate production name to add.

# ── QuickBooks DESKTOP integration, via Conductor (backend-only) ─────────────
# A company connects EITHER QuickBooks Online or Desktop, never both, so the two
# blocks are alternatives per tenant rather than a pair to fill in together.
# Keys from https://dashboard.conductor.is -> your project -> API keys.
#
# ONE name per key, whose VALUE differs per deployment environment — set the
# TESTING project's keys for local/preview and the PRODUCTION project's keys for
# production, in Vercel's per-environment scoping. There is deliberately no
# CONDUCTOR_PROD_* variant: a second name is one more thing to keep in sync, and
# the QBO block above shows how that ends — it has the prod names AND falls back
# to the sandbox ones, which is the hazard the split was meant to prevent.
# Scope each variable to ONE Vercel environment; "All Environments" would point
# production at the testing project's books.
CONDUCTOR_API_KEY=your-conductor-secret-key
# Embedded in the setup URL the shop opens on the computer running QuickBooks.
# NOT NEXT_PUBLIC_* — that is inlined at build time, and a preview build that
# outran provisioning once baked in an empty value.
CONDUCTOR_PUBLISHABLE_KEY=your-conductor-publishable-key
# Conductor bills per connected company file. The `quickbooks_desktop` flag that
# gated the backend connect endpoint is gone — connecting is self-serve for any
# company admin now, and admin-ness is the only thing between a click and a
# billable connection. Sample and trial company files are free.

# ── Stripe subscription billing ──────────────────────────────────────────────
# Backend only — no NEXT_PUBLIC_STRIPE_* (Checkout + Portal are server-created
# redirect URLs; there is no Stripe.js on the client). The app reads a RESTRICTED
# key (rk_...) — least-privilege, and it matches the var the Stripe Dashboard /
# Vercel label. Use separate keys per environment (test vs live).
STRIPE_RESTRICTED_KEY=rk_test_your-restricted-key
# The DEFAULT monthly Price id ($399) — chosen server-side for every self-serve
# signup. The frontend never names a price. The superseded $300 price is still
# active in Stripe; don't point this back at it (docs/modules/billing.md §6).
STRIPE_PRICE_ID=price_your-default-399-price-id
# The reserved founder-customer Price id ($250). NOT read by the app directly —
# it's the value you put in a company's company_billing.override_price_id
# (service-role) to give that one customer the founder rate.
STRIPE_FOUNDING_PRICE_ID=price_your-founder-250-price-id
# Webhook signing secret. LOCAL: the `whsec_...` printed by `stripe listen`.
# DEPLOYED: the signing secret of the Dashboard webhook endpoint (they differ!).
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# ── AI: providers, chains, and the desktop worker ────────────────────────────
# None of the AI vars were documented here until 2026-08-25, including the two
# that predate this file. If a var is missing from this list the failure is silent
# — the feature just does nothing — so add new ones here in the same change.

# Anthropic, for surfaces not yet migrated to local inference.
ANTHROPIC_API_KEY=sk-ant-your-key
# ANTHROPIC_BASE_URL is deliberately ABSENT and must stay absent outside E2E. The
# SDK falls back to it only while no base_url is passed in code, and that fallback
# is the entire mechanism behind e2e/mocks/anthropic-server.mjs. Setting it here
# would silently redirect your local app at a mock.

# The read-only connection the insights execute_sql sandbox runs on. LOCALLY this
# points at the postgres superuser, which is BYPASSRLS — so per-company scoping in
# the SQL sandbox does nothing on a local stack. That is fine for a local stack and
# catastrophic anywhere else; the worker refuses to start if it sees this shape
# against a remote host.
AI_READONLY_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Which providers serve which feature, in order. Comma-separated `slug[:model]`.
# Split on the FIRST colon only — an Ollama tag contains one ("qwen3:8b").
#
# A production chain is LOCAL-ONLY or HOSTED-ONLY, never mixed: a migrated surface
# must fail visible when the desktop is down rather than quietly falling back to a
# hosted model at forty times the cost. Defaults (in services/llm/registry.py) are
# all `anthropic`, so an unset var changes nothing.
# LLM_CHAIN_INSIGHTS=ollama:qwen3:8b
# LLM_CHAIN_DRAWINGS=anthropic

# `dev` routes insights to insights_dev (local qwen3:8b) so laptop experiments
# cannot bill anyone. EXPLICIT, never inferred from VERCEL_ENV — index.py records
# the incident where an inferred environment made local, pytest, preview and
# production all report as "development".
LLM_PROFILE=dev

# Ollama's OpenAI-compatible path. The worker talks to this; Vercel never does.
OLLAMA_BASE_URL=http://localhost:11434/v1

# DeepInfra: the eval harness and an emergency per-feature toggle that ships OFF.
# ITS KEY NEVER GOES TO VERCEL — naming deepinfra in a production chain raises.
# DEEPINFRA_API_KEY=your-deepinfra-key
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# ── The desktop AI worker (worker/) — set these on the shop box, not on Vercel ─
# worker/__main__.py reads THIS file and only this file; the shell wins over it,
# and that is the whole precedence rule. docs/runbooks/ai-worker.md §2.
# WORKER_ID=desktop-1
# The queue connection, as the least-privilege jigged_ai_worker role. That role is
# created NOLOGIN by its migration and granted LOGIN + a password by hand in the
# Supabase dashboard (production) or by supabase/seed.sql (local and preview).
# NEVER the service-role key: this role can claim jobs and write ai_calls, and
# holds no SELECT on any tenant table.
# WORKER_DATABASE_URL=postgresql://jigged_ai_worker:...@...:5432/postgres
# The SQL sandbox's connection, as jigged_ai_readonly. NAMED APART FROM
# AI_READONLY_DATABASE_URL ABOVE ON PURPOSE, and not for tidiness: that one is the
# local postgres superuser (BYPASSRLS) for the backend's own use, and one machine
# can run the backend against a local stack and the worker against a real shop at
# the same time. While both processes read one name, load order decided which
# database a shop's question was answered from.
# WORKER_READONLY_DATABASE_URL=postgresql://jigged_ai_readonly:...@...:5432/postgres
# WORKER_MODELS=qwen3:8b,qwen3-vl:4b
# WORKER_LEASE_SECONDS=300
