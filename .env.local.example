# Supabase Configuration
# Get these values from your Supabase project settings:
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SECRET_KEY=your-secret-key-here

# Supabase Storage Bucket Name
# This is the name of the S3 bucket for file attachments (quotes, jobs)
NEXT_PUBLIC_SUPABASE_S3_BUCKET=your-bucket-name

# API URL - only needed for local development
# Leave unset in production (Vercel uses relative URLs since FastAPI runs on same domain)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── QuickBooks Online integration (backend-only; push quotes -> invoices) ──
# Developer (sandbox) app keys from https://developer.intuit.com -> your app -> Keys & OAuth.
QUICK_BOOKS_CLIENT_ID=your-quickbooks-client-id
QUICK_BOOKS_CLIENT_SECRET=your-quickbooks-client-secret
# 'sandbox' while testing with dev keys; 'production' once Intuit issues prod keys.
QUICKBOOKS_ENVIRONMENT=sandbox
# Must EXACTLY match a Redirect URI registered on the Intuit app (Keys & OAuth).
QUICKBOOKS_REDIRECT_URI=http://localhost:8000/api/quickbooks/callback
# Frontend origin the post-OAuth callback redirects back to. Set per environment
# to the STABLE domain (same host as QUICKBOOKS_REDIRECT_URI). Locally the frontend
# is :3000 while the backend callback is :8000, so they differ. Do NOT use Vercel's
# dynamic VERCEL_URL here — it's the deployment host, not the user's domain.
APP_BASE_URL=http://localhost:3000
# HMAC secret for the OAuth state token (falls back to SUPABASE_JWT_SECRET if unset).
QUICKBOOKS_STATE_SECRET=generate-a-random-string
# Pin a QBO API minor version (test bumps in sandbox before production).
QUICKBOOKS_MINOR_VERSION=75
# Production-only keys, added once Intuit approves the app for production:
# QUICKBOOKS_PROD_CLIENT_ID=your-production-client-id
# QUICKBOOKS_PROD_CLIENT_SECRET=your-production-client-secret
