# E2E Test Configuration
# Copy this file to .env.test.local and fill in the values.
# These credentials correspond to a pre-seeded test user in your staging Supabase project.

E2E_TEST_EMAIL=e2e-test@jigged.app
E2E_TEST_PASSWORD=your-test-password-here

# Optional: Override the base URL (defaults to http://localhost:3000)
# PLAYWRIGHT_TEST_BASE_URL=https://your-preview-url.vercel.app
