# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*

# npm lockfile — this project uses pnpm; pnpm-lock.yaml is the source of truth.
package-lock.json
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/playwright/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# MCP configuration (contains API tokens)
.mcp.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# API cache (dev only)
api/.cache/

# Sentry Config File
.env.sentry-build-plugin

# Usability test data (contains user research / PII)
docs/usability-tests/
scripts/data/

# Supabase
supabase/.temp/

# pytest-cov artifact
api/.coverage

# Claude Code: local settings + git worktrees (kept out of version control).
# settings.json is re-included so shared, team-level Claude config can still be committed.
.claude/*
!.claude/settings.json

# Local UI-drive screenshots (may contain real customer data — never commit)
.screenshots/

# Blender
/outputs/
# 3d-experiments: local copy of the (gitignored) Blender export, kept out of git
/public/week1-scene.glb
