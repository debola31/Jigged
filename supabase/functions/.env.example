# Local secrets for the Supabase Edge Functions (team-invites, team,
# notify-feedback, notify-waitlist). Copy to `supabase/functions/.env`
# (gitignored) and fill in, then serve with:
#
#   supabase functions serve --env-file supabase/functions/.env
#
# LOCAL ONLY — never commit real keys. The functions call the Resend HTTP API
# directly, so use a Resend TEST key (or one restricted to a verified test
# domain) to be sure local runs never email real recipients. SUPABASE_URL /
# SUPABASE_SERVICE_ROLE_KEY are injected by the local stack — don't set them here.

RESEND_API_KEY=re_test_xxxxxxxxxxxxxxxxxxxxxxxx
SITE_URL=http://localhost:3000
JIGGED_FROM_EMAIL=Jigged <hello@jigged.app>
